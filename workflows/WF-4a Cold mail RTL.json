t-size: 1px; line-height: 1px;\">&nbsp;</td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n          \n          <!-- Greeting -->\n          <tr>\n            <td style=\"padding: 0 0 20px 0; font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #333333;\">\n              שלום {{ $('Search New Leads').item.json.Name }}\n            </td>\n          </tr>\n          \n          <!-- Paragraph 1 -->\n          <tr>\n            <td style=\"padding: 0 0 20px 0; font-family: Arial, sans-serif; font-size: 16px; line-height: 1.6; color: #333333;\">\n              {{ $json.text }}\n            </td>\n          </tr>\n\n          \n          <!-- Sign-off -->\n          <tr>\n            <td style=\"padding: 0 0 5px 0; font-family: Arial, sans-serif; font-size: 16px; line-height: 1.5; color: #333333;\">\n              בברכה.\n            </td>\n          </tr>\n          \n        </table>\n        <!-- End Email Body Wrapper -->\n\n      </td>\n    </tr>\n  </table>\n  <!-- End Main Container Table -->\n\n</body>\n</html>",
