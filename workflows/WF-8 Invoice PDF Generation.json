    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"he\" dir=\"rtl\">\n<head>\n    <meta charset=\"UTF-8\">\n    <title>AI Gear Electronics</title>\n    <style>\n        @import url('https://fonts.googleapis.com/css2?family=Rubik:wght@300;400;500;700&display=swap');\n        \n        @page {\n            size: A4;\n            margin: 20mm;\n        }\n        \n        body {\n            font-family: 'Rubik', sans-serif;\n            color: #333;\n            line-height: 1.4;\n            margin: 0;\n            padding: 0;\n            background-color: #ffffff;\n            font-size: 14px;\n        }\n        \n        .receipt-container {\n            width: 100%;\n            max-width: 800px;\n            margin: 0 auto;\n        }\n        \n        /* Header Section */\n        .header {\n            display: flex;\n            justify-content: space-between;\n            align-items: flex-start;\n            border-bottom: 2px solid #3b82f6;\n            padding-bottom: 20px;\n            margin-bottom: 30px;\n        }\n        \n        .company-details h1 {\n            margin: 0 0 5px 0;\n            color: #1e3a8a;\n            font-size: 28px;\n            font-weight: 700;\n        }\n        \n        .company-details p {\n            margin: 3px 0;\n            color: #4b5563;\n        }\n        \n        .receipt-title {\n            text-align: left;\n        }\n        \n        .receipt-title h2 {\n            margin: 0 0 10px 0;\n            color: #1e3a8a;\n            font-size: 32px;\n            font-weight: 700;\n            letter-spacing: 1px;\n        }\n        \n        /* Meta Info Grid */\n        .meta-grid {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 20px;\n            margin-bottom: 30px;\n            background-color: #f8fafc;\n            padding: 15px;\n            border-radius: 8px;\n            border: 1px solid #e2e8f0;\n        }\n        \n        .meta-block h3 {\n            margin: 0 0 8px 0;\n            color: #1e3a8a;\n            font-size: 16px;\n            border-bottom: 1px solid #cbd5e1;\n            padding-bottom: 4px;\n        }\n        \n        .meta-block p {\n            margin: 4px 0;\n            color: #334155;\n        }\n        \n        .meta-block span {\n            font-weight: 500;\n        }\n        \n        /* Items Table */\n        table {\n            width: 100%;\n            border-collapse: collapse;\n            margin-bottom: 30px;\n        }\n        \n        th {\n            background-color: #1e3a8a;\n            color: white;\n            text-align: right;\n            padding: 12px;\n            font-weight: 500;\n        }\n        \n        th:last-child, td:last-child {\n            text-align: left;\n        }\n        \n        td {\n            padding: 12px;\n            border-bottom: 1px solid #e2e8f0;\n            color: #334155;\n        }\n        \n        .tr-alternate:nth-child(even) {\n            background-color: #f8fafc;\n        }\n        \n        /* Summary Section */\n        .summary-container {\n            display: flex;\n            justify-content: space-between;\n            align-items: flex-start;\n            margin-top: 20px;\n        }\n        \n        .payment-info {\n            width: 45%;\n            background-color: #f1f5f9;\n            padding: 15px;\n            border-radius: 8px;\n            border: 1px solid #e2e8f0;\n        }\n        \n        .payment-info h4 {\n            margin: 0 0 8px 0;\n            color: #1e3a8a;\n            font-size: 15px;\n        }\n        \n        .payment-info p {\n            margin: 4px 0;\n            color: #475569;\n        }\n        \n        .totals {\n            width: 45%;\n        }\n        \n        .total-row {\n            display: flex;\n            justify-content: space-between;\n            padding: 8px 0;\n            border-bottom: 1px solid #e2e8f0;\n            color: #475569;\n        }\n        \n        .total-row.grand-total {\n            border-bottom: none;\n            padding-top: 12px;\n            font-size: 18px;\n            font-weight: 700;\n            color: #1e3a8a;\n        }\n        \n        /* Footer */\n        .footer {\n            margin-top: 60px;\n            text-align: center;\n            color: #94a3b8;\n            font-size: 12px;\n            border-top: 1px solid #e2e8f0;\n            padding-top: 15px;\n        }\n        \n        /* Print optimization */\n        @media print {\n            body {\n                background-color: #fff;\n                -webkit-print-color-adjust: exact;\n                print-color-adjust: exact;\n            }\n            .receipt-container {\n                max-width: 100%;\n            }\n        }\n    </style>\n</head>\n<body>\n\n<div class=\"receipt-container\">\n    <!-- Header -->\n    <div class=\"header\">\n        <div class=\"company-details\">\n            <h1>AI Gear Electronics</h1>\n\t<p>מוצרי אלקטרוניקה מקוריים באחריות יבואן רשמי</p>\n</br>\n            <p>ח.פ. / ע.מ: 5123456789</p>\n            <p>רחוב דרך מנחם בגין 889, תל אביב</p>\n            <p>טלפון: 03-555-1234 | דוא\"ל: info@aigearelectronics.co.il</p>\n        </div>\n        <div class=\"receipt-title\">\n            <h2>{{ $('Search Invoice').item.json.fields.InvoiceType }}</h2>\n            <p>מקור</p>\n        </div>\n    </div>\n\n    <!-- Meta Information -->\n    <div class=\"meta-grid\">\n        <div class=\"meta-block\">\n            <h3>פרטי מסמך</h3>\n            <p><span>מספר חשבונית:</span> {{ $('Search Invoice').item.json.fields.InvoiceNumber }}</p>\n            <p><span>תאריך:</span> {{ $('Search Invoice').item.json.fields.Created }}</p>\n            <p><span>טלפון:</span> {{ $('Search Customer').item.json.fields.Phone }}</p>\n        </div>\n        <div class=\"meta-block\">\n            <h3>לכבוד</h3>\n            <p><span>שם הלקוח:</span> {{ $('Search Customer').item.json.fields.Name }}</p>\n            <p><span>חברה:</span> {{ $('Search Customer').item.json.fields.Company }}</p>\n            <p><span>כתובת מייל:</span> {{ $('Search Customer').item.json.fields.Mail }}</p>\n        </div>\n    </div>\n\n\n    <!-- Items Table -->\n    <table>\n        <thead>\n            <tr>\n                <th style=\"width: 10%;\">#</th>\n                <th style=\"width: 45%;\">תיאור הפריט</th>\n                <th style=\"width: 15%;\">כמות</th>\n                <th style=\"width: 15%;\">מחיר יחידה</th>\n                <th style=\"width: 15%;\">סה\"כ</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr class=\"tr-alternate\">\n                <td>1</td>\n                <td>{{ $json.fields.Name }}</td>\n                <td>1</td>\n                <td>₪{{ $json.fields.Price }}</td>\n                <td>₪{{ $json.fields.Price }}</td>\n            </tr>\n\n\n        </tbody>\n    </table>\n\n    <!-- Summary -->\n    <div class=\"summary-container\">\n        <div class=\"payment-info\">\n            <h4>פירוט תשלום:</h4>\n            <p>שולם באמצעות כרטיס אשראי (ויזה)</p>\n            <p>ארבע ספרות אחרונות: 1234</p>\n            <p>אישור עסקה מס': 987654</p>\n        </div>\n        <div class=\"totals\">\n            <div class=\"total-row\">\n                <span>סה\"כ לפני מע\"מ:</span>\n                <span>₪{{ $('Search Invoice').item.json.fields.Amount }}</span>\n            </div>\n            <div class=\"total-row\">\n                <span>מע\"מ (18%):</span>\n                <span>₪0.0</span>\n            </div>\n            <div class=\"total-row grand-total\">\n                <span>סה\"כ לתשלום:</span>\n                <span>₪{{ $('Search Invoice').item.json.fields.Amount }}</span>\n            </div>\n        </div>\n    </div>\n\n    <!-- Footer -->\n    <div class=\"footer\">\n        <p>תודה שקניתם ב-AI Gear Electronics!</p>\n        <p>הסחורה נשארת בבעלות המוכר עד לתשלום המלא.</p>\n    </div>\n</div>\n\n</body>\n</html>\n"
      },
